# ------------------------------------------------------------------------------
# PokéLink — configuration contract
#
# Every value below works verbatim inside the docker-compose network. Copy this
# file to .env and run `docker compose up -d`; no manual edit is required.
# (If .env is missing, the container entrypoint makes this copy for you.)
#
# APP_KEY is the single intentionally empty value — the entrypoint generates it
# on first boot via `php artisan key:generate`.
# ------------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
APP_NAME=PokeLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
APP_MAINTENANCE_DRIVER=file

# Host port published by the `web` service. Change this if 8000 is already bound.
APP_PORT=8000

# --- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# --- Database -----------------------------------------------------------------
# DB_HOST/DB_PORT address the `mysql` service on the compose network. To reach
# MySQL from the host with a GUI client, change FORWARD_DB_PORT instead — that
# is the host-side publish port and it never affects the app's own connection.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pokelink
DB_USERNAME=pokelink
DB_PASSWORD=pokelink
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3306

# --- Session ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Cache and queue ----------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=pokelink_cache
QUEUE_CONNECTION=redis

# --- Redis --------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# --- Broadcasting -------------------------------------------------------------
BROADCAST_CONNECTION=reverb

# --- Reverb (server side) -----------------------------------------------------
# REVERB_HOST/REVERB_PORT are what the browser connects to, so they name the
# host, not the compose service. REVERB_SERVER_HOST must stay 0.0.0.0 so the
# server binds every interface inside its container.
REVERB_APP_ID=pokelink
REVERB_APP_KEY=pokelink-key
REVERB_APP_SECRET=pokelink-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Reverb (client side, compiled into the bundle by Vite) -------------------
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Horizon ------------------------------------------------------------------
HORIZON_PREFIX=pokelink_horizon:

# --- Filesystem and mail ------------------------------------------------------
FILESYSTEM_DISK=local
MAIL_MAILER=log
